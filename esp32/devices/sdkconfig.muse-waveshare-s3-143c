# Waveshare ESP32-S3-Touch-AMOLED-1.43C: ESP32-S3-PICO-1-N8R8 (8 MB flash,
# 8 MB octal PSRAM), round 466x466 touch AMOLED, ES8311 + ES7210, battery.
# Load last, after sdkconfig.muse.
#
# This is NOT the StopWatch config: that board is 16 MB flash with a PMU,
# IMU and RTC. This board is 8 MB flash with none of those, so it takes
# partitions_muse_8mb.csv (the same layout the lost firmware shipped:
# ota_0/ota_1 3.9 MB each, prod_data/prod_bak 4 KB each) and no PMU code.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_MUSE_BOARD_WAVESHARE_S3_143C=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_muse_8mb.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# Flash mode/speed per the board's flashing spec: dio, 80 MHz. The flash
# chip itself is QIO-capable, but the verified flashing params say dio;
# do not switch to QIO without confirming it on hardware first.
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# As on the AIPI: static buffers in PSRAM, or BLE setup can't find 8 KB of
# internal RAM for its task.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# CONFIG_SPIRAM_IGNORE_NOTFOUND is not set
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=8
# Two-button menu.
CONFIG_LV_FONT_MONTSERRAT_12=y
# Chinese/Japanese captions (this board's replies are Chinese). About
# 850 KB of flash; the 3.9 MB OTA slots still fit the app with room left.
CONFIG_MUSE_CJK_FONT=y
# Screen off on battery: light sleep between button presses, as on the
# StickS3. No 32 kHz crystal here either, so the sleep clock is the main
# crystal, kept powered. Wake source is the BOOT button (see wait_buttons
# in board_waveshare_s3_143c.c).
CONFIG_PM_ENABLE=y
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_BT_CTRL_MODEM_SLEEP=y
CONFIG_BT_CTRL_MODEM_SLEEP_MODE_1=y
CONFIG_BT_CTRL_LPCLK_SEL_MAIN_XTAL=y
CONFIG_BT_CTRL_MAIN_XTAL_PU_DURING_LIGHT_SLEEP=y
CONFIG_USJ_NO_AUTO_LS_ON_CONNECTION=y
# CONFIG_PM_POWER_DOWN_CPU_IN_LIGHT_SLEEP is not set
# CONFIG_ESP_SLEEP_GPIO_RESET_WORKAROUND is not set
CONFIG_PM_LIGHT_SLEEP_CALLBACKS=y
CONFIG_PM_PROFILING=y
